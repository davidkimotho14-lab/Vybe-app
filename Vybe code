name: Build VYBE Android Debug APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Install dependencies & build web bundle
        run: |
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm run build

      - name: Generate Android Capacitor project & build debug APK
        run: |
          if [ ! -d android ]; then npx cap add android; fi
          cp public/vybe-icon-192.png android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png || true
          npx cap sync android
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload VYBE Debug APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: vybe-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
